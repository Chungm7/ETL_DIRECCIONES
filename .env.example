# ==============================================================================
# CONFIGURACIÓN DEL PROYECTO ETL MIGRACIÓN MPCH (MÉTODO IN-PLACE ÚNICO)
# ==============================================================================

ENV=development
LOG_LEVEL=INFO

# --- Conexión a Base de Datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bd_mpch
DB_USER=postgres
DB_PASSWORD=postgres

# --- Esquema y Tabla de Direcciones a Procesar (In-Place) ---
# Esquema de trabajo donde reside la tabla de direcciones (ej. public, schema_solo_tabla, etc.)
DB_SCHEMA=public
# Tabla única de direcciones que se lee y se modifica in-place conservando sus IDs
DB_TABLE=direcciones_actual
# Columna identificadora (Primary Key) que se conserva estrictamente intacta
DB_ID_COL=id_licencia
# Columna que contiene el texto de la dirección original sin estructurar
DB_DIR_COL=emp_direccion

# --- Tablas Maestras Categorizables (En el mismo esquema) ---
# Tablas de catálogos que el ETL examina, crea y/o sincroniza dinámicamente
DB_TABLE_TIPO_VIA=tipos_via
DB_TABLE_TIPO_ZONA=tipos_zona

# --- Nombres Dinámicos de Columnas Normalizadas (Agregadas In-Place) ---
# Columnas que se crean vía ALTER TABLE IF NOT EXISTS y se actualizan con los datos normalizados
COL_TIPO_VIA=tipo_via
COL_NOM_VIA=nom_via
COL_NUM_VIA=num_via
COL_TIPO_ZONA=tipo_zona
COL_NOM_ZONA=nom_zona
COL_MANZANA=manzana
COL_LOTE=lote
COL_SLOTE=slote
COL_REFERENCIA=referencia


# --- Conexión a Servidor de Ollama (IA Local / Remota) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=60
OLLAMA_TEMPERATURE=0.0

# --- Parámetros de Ejecución del Pipeline ETL ---
# Método único oficial: in_place (evolución de la tabla en sitio sin crear tablas duplicadas)
ETL_MODE=in_place
ETL_BATCH_SIZE=50
ETL_MAX_RETRIES=3
USE_AI_PARSER=true
# Si es true, el ETL aborta inmediatamente si Ollama se apaga. Si es false, permite contingencia heurística.
ETL_REQUIRE_AI=true
